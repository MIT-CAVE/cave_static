{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "plan",
    "allow": [
      "Read(./src/**)",
      "Edit(./src/**)",
      "Write(./src/**)",
      "Read(./*.js)",
      "Edit(./*.js)",
      "Read(./package.json)",
      "Edit(./package.json)",
      "Read(./index.html)",
      "Edit(./index.html)",
      "Read(./DEVELOPMENT.md)",
      "Edit(./DEVELOPMENT.md)",
      "Read(./README.md)",
      "Edit(./README.md)"
    ],
    "deny": [
      "Read(.env)",
      "Read(*.env*)",
      "Read(**/*.env*)",
      "Read(**/key/**)",
      "Read(**/keys/**)",
      "Read(**/secret/**)",
      "Bash(rm *)",
      "Bash(git *)",
      "Read(cache/**)",
      "Read(dist/**)",
      "Read(**/__pycache__/**)",
      "Read(**/venv/**)",
      "Read(build/**)",
      "Read(node_modules/**)"
    ]
  }
}
